# ==============================================================
# JANIDA SAS — Variables de entorno (documento completo)
#
# Copia este archivo como `.env` y ajusta los valores. La app
# también funciona sin archivo .env usando los valores por
# defecto de `src/lib/config.ts`, pero se recomienda fijarlos
# explícitamente en producción.
#
# El negocio NO usa pasarela de tarjetas: el checkout es B2B con
# factura comercial (prepago o crédito a 30/60/90 días). No hay
# claves de pasarela de pago que configurar.
# ==============================================================

# --------------------------------------------------------------
# PANEL ADMIN — credenciales del ÚNICO administrador
# --------------------------------------------------------------
# Correo de inicio de sesión en /admin
ADMIN_EMAIL=admin@janida.co
# Hash del password del admin (NUNCA el password en texto claro).
# Hash scrypt de ejemplo del password "admin123".
# Genera uno nuevo con:  npm run hash:password -- "TuClaveNueva"
# ⚠️ Los "$" del hash van ESCAPADOS con "\$" en este archivo
#    (Next.js expande $VARIABLE al leer .env). Ejemplo:
#    scrypt\$n=16384\$r=8\$p=1\$<salt>\$<hash>
ADMIN_PASSWORD_HASH=scrypt\$n=16384\$r=8\$p=1\$d5b346cda8ca973f\$5cfad84d11aa0c565b3cc21a1fb7732f672a0736270067d632b664606c72d17ecb88c32849ae038533f757a2355d8d96799d082fac850fe9ff5b500eee74b70a
# Semilla para firmar la cookie de sesión del admin (HMAC-SHA256).
# En producción usa 32+ caracteres aleatorios:  openssl rand -hex 32
ADMIN_SESSION_SECRET=cambia-esta-semilla-super-secreta-de-32-caracteres

# --------------------------------------------------------------
# DIVISA
# --------------------------------------------------------------
# Moneda base de ALMACENAMIENTO y de cálculo de todos los totales
# (decisión de diseño: precios en USD, mercado destino). El COP se
# muestra solo como equivalente informativo.
CURRENCY_BASE=USD

# --------------------------------------------------------------
# TASA DE CAMBIO USD → COP
# --------------------------------------------------------------
# Tasa INICIAL del sistema: 1 USD = 3 800 COP (valor de la semilla
# en settings.exchangeRateCOP del almacén; el dashboard y las
# equivalencias uses esa tasa). El simulador del dólar del panel
# permite evaluar el margen ante movimientos de la tasa.
EXCHANGE_RATE_COP=3800

# --------------------------------------------------------------
# CATÁLOGO / INVENTARIO
# --------------------------------------------------------------
# Unidad de venta: CAJA entera sellada de 200 tallos (valor del
# dominio, no configurable por entorno).
# Umbral (en CAJAS) para las alertas de inventario bajo del panel
LOW_STOCK_THRESHOLD_BOXES=20

# --------------------------------------------------------------
# IDENTIDAD
# --------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="JANIDA SAS"
# Los marcadores de contacto del sitio (+1 (000) 000-0000 y
# contact@janida.example) viven como textos de ejemplo en el
# diccionario i18n (scripts/i18n.py); reemplázalos allí cuando
# Janida comparta los datos reales de Ventas EE. UU.
