# ==============================================================
# JANIDA SAS — Variables de entorno (documento completo)
#
# Copia este archivo como `.env` y ajusta los valores. La app
# también funciona sin archivo .env usando los valores por
# defecto de demo definidos en `src/lib/config.ts`, pero se
# recomienda fijarlos explícitamente en producción.
# ==============================================================

# --------------------------------------------------------------
# PANEL ADMIN — credenciales del ÚNICO administrador
# --------------------------------------------------------------
# Correo de inicio de sesión en /admin
ADMIN_EMAIL=admin@janida.co
# Hash del password del admin (NUNCA el password en texto claro).
# Hash scrypt de demo del password "admin123".
# Genera uno nuevo con:  npm run hash:password -- "TuClaveNueva"
ADMIN_PASSWORD_HASH=scrypt\$n=16384\$r=8\$p=1\$d5b346cda8ca973f\$5cfad84d11aa0c565b3cc21a1fb7732f672a0736270067d632b664606c72d17ecb88c32849ae038533f757a2355d8d96799d082fac850fe9ff5b500eee74b70a
# Semilla para firmar la cookie de sesión del admin (HMAC-SHA256).
# En producción usa 32+ caracteres aleatorios:  openssl rand -hex 32
ADMIN_SESSION_SECRET=cambia-esta-semilla-super-secreta-de-32-caracteres

# --------------------------------------------------------------
# IDENTIDAD VISUAL / DATOS CORPORATIVOS (públicos)
# --------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="JANIDA SAS"
NEXT_PUBLIC_BRAND_TAGLINE="Claveles de la Sabana de Bogotá, con frescura y cumplimiento para el mercado mayorista de Estados Unidos."
# Datos de contacto mostrados en el sitio (son datos demo)
NEXT_PUBLIC_CONTACT_EMAIL=ventas@janida.co
NEXT_PUBLIC_CONTACT_PHONE_US=+1 (305) 555-0199
NEXT_PUBLIC_CONTACT_PHONE_CO=+57 320 555 0199

# --------------------------------------------------------------
# DIVISA
# --------------------------------------------------------------
# Moneda base de ALMACENAMIENTO y de cálculo de todos los totales.
# Decisión de diseño: precios guardados en USD (mercado destino).
CURRENCY_BASE=USD
NEXT_PUBLIC_CURRENCY_BASE=USD

# --------------------------------------------------------------
# TASA DE CAMBIO USD → COP (conversión automática en la UI)
# --------------------------------------------------------------
# 1 USD = EXCHANGE_RATE_COP COP (tasa de demo). Decimales permitidos.
EXCHANGE_RATE_COP=4200

# --------------------------------------------------------------
# PAGO SIMULADO (mock tipo Stripe) — NO procesa cobros reales
# Documentación para conectar Stripe real: docs/STRIPE-INTEGRATION.md
# --------------------------------------------------------------
PAYMENT_MOCK_PUBLIC_KEY=pk_demo_janida_sas
PAYMENT_MOCK_SECRET_KEY=sk_demo_janida_sas_04eirent2j4f0p4y
PAYMENT_PROVIDER=mock
NEXT_PUBLIC_PAYMENT_PROVIDER=mock

# --------------------------------------------------------------
# BANDERAS DE DEMO / CATÁLOGO
# --------------------------------------------------------------
# Notas de "datos de ejemplo / pago simulado" en la interfaz pública
NEXT_PUBLIC_DEMO_MODE=true
# Tamaño fijo del paquete (todas las ventas van en paquetes cerrados)
NEXT_PUBLIC_PACKAGE_SIZE=200
# Stock mínimo (en paquetes) para alertar bajo inventario en el admin
LOW_STOCK_THRESHOLD_PACKAGES=80
